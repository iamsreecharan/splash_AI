# Local demo. Copy to .env; keep .env private. No paid services are required.
POSTGRES_USER=splash
POSTGRES_PASSWORD=splash-local-only
POSTGRES_DB=splash
SPLASH_ENV=development
SPLASH_DEMO_MODE=true
SPLASH_DATABASE_URL=postgresql+psycopg://splash:splash-local-only@postgres:5432/splash
SPLASH_REDIS_URL=redis://redis:6379/0
SPLASH_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SPLASH_PUBLIC_API_URL=http://localhost:8000
SPLASH_WEB_URL=http://localhost:5173

# Opt in to hosted AI only after reading docs/privacy.md and docs/costs.md.
SPLASH_AI_ENABLED=false
SPLASH_OPENAI_API_KEY=
SPLASH_OPENAI_MODEL=gpt-4.1-mini
# Per-provider-instance estimates, not a monthly/account-wide dollar cap.
SPLASH_AI_MAX_INPUT_TOKENS=6000
SPLASH_AI_MAX_OUTPUT_TOKENS=700
SPLASH_AI_MAX_SNIPPETS=8
SPLASH_AI_MAX_SNIPPET_CHARS=1800
SPLASH_AI_MAX_REQUEST_USD=0.02
SPLASH_AI_MAX_TOTAL_USD=0.02

# Live pilot: set DEMO_MODE=false and configure Supabase Auth + GitHub App.
# Public Supabase anon/publishable key is safe in the browser; never use service-role.
SPLASH_SUPABASE_URL=
SPLASH_SUPABASE_ANON_KEY=
SPLASH_GITHUB_APP_ID=
SPLASH_GITHUB_APP_SLUG=
SPLASH_GITHUB_CLIENT_ID=
SPLASH_GITHUB_CLIENT_SECRET=
SPLASH_GITHUB_WEBHOOK_SECRET=
# Set to /run/splash-secrets/github-app.pem after placing the PEM in .secrets/.
SPLASH_GITHUB_PRIVATE_KEY_PATH=
# Generate a persistent Fernet key; see docs/github-app.md. Do not rotate blindly.
SPLASH_TOKEN_ENCRYPTION_KEY=

# Frontend Docker development proxy. No secrets belong in VITE_* variables.
VITE_API_PROXY_TARGET=http://backend:8000
